<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <requires lib="Adw" version="1.0"/>
  <template class="ThirtiesWindow" parent="AdwApplicationWindow">
    <property name="title" translatable="yes">Thirties</property>
    <property name="default-width">1240</property>
    <property name="default-height">800</property>
    <property name="width-request">360</property>
    <property name="height-request">480</property>
    <property name="content">
      <object class="AdwToastOverlay" id="toast_overlay">
        <property name="child">
          <!-- Schedule on the left, chat on the right: equal halves when wide, the chat
               overlaid when narrow. Each pane has its own header bar (libadwaita's
               split-view pattern), so the chat runs the full height of the window. -->
          <object class="AdwOverlaySplitView" id="split_view">
            <property name="hexpand">True</property>
            <property name="vexpand">True</property>
            <property name="sidebar-position">end</property>
            <property name="sidebar-width-fraction">0.5</property>
            <property name="min-sidebar-width">340</property>
            <property name="max-sidebar-width">4000</property>
            <property name="show-sidebar" bind-source="chat_toggle_btn" bind-property="active" bind-flags="sync-create|bidirectional"/>
            <property name="content">
              <object class="AdwToolbarView" id="content_toolbar">
                <child type="top">
                  <object class="AdwHeaderBar">
                    <child type="start">
                      <object class="GtkBox">
                        <property name="spacing">2</property>
                        <child>
                          <object class="GtkButton" id="prev_day_btn">
                            <property name="icon-name">go-previous-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Previous Day</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkMenuButton" id="calendar_menu_btn">
                            <property name="icon-name">x-office-calendar-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Jump to Date</property>
                            <property name="popover">
                              <object class="GtkPopover" id="calendar_popover">
                                <child>
                                  <object class="GtkCalendar" id="date_calendar"/>
                                </child>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="next_day_btn">
                            <property name="icon-name">go-next-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Next Day</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="today_btn">
                            <property name="icon-name">go-today-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Jump to Today</property>
                            <property name="sensitive">False</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child type="title">
                      <object class="AdwWindowTitle" id="window_title">
                        <property name="title" translatable="yes">Thirties</property>
                      </object>
                    </child>
                    <child type="end">
                      <object class="GtkMenuButton">
                        <property name="primary">True</property>
                        <property name="icon-name">open-menu-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Main Menu</property>
                        <property name="menu-model">primary_menu</property>
                      </object>
                    </child>
                    <child type="end">
                      <object class="GtkToggleButton" id="chat_toggle_btn">
                        <property name="icon-name">sidebar-show-right-symbolic</property>
                        <property name="tooltip-text" translatable="yes">Show or Hide Chat (F9)</property>
                        <property name="active">True</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>
            <property name="sidebar">
              <object class="AdwToolbarView" id="chat_toolbar">
                <child type="top">
                  <object class="AdwHeaderBar" id="chat_header"/>
                </child>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
    <child>
      <object class="AdwBreakpoint">
        <condition>max-width: 760sp</condition>
        <setter object="split_view" property="collapsed">True</setter>
        <setter object="split_view" property="sidebar-width-fraction">1.0</setter>
      </object>
    </child>
  </template>
  <menu id="primary_menu">
    <section>
      <attribute name="label" translatable="yes">Assistant</attribute>
      <item>
        <attribute name="label" translatable="yes">Gemini (cloud, for developers)</attribute>
        <attribute name="action">win.brain</attribute>
        <attribute name="target">frontier</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Gemma (on this device)</attribute>
        <attribute name="action">win.brain</attribute>
        <attribute name="target">slm</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">Profile &amp; _Memory</attribute>
        <attribute name="action">win.profile-memory</attribute>
      </item>
    </section>
    <section>
      <item>
        <attribute name="label" translatable="yes">_Preferences</attribute>
        <attribute name="action">app.preferences</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_Keyboard Shortcuts</attribute>
        <attribute name="action">app.shortcuts</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">_About Thirties</attribute>
        <attribute name="action">app.about</attribute>
      </item>
    </section>
  </menu>
</interface>
